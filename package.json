{
  "name": "frontend-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "cap:init": "node ./node_modules/@capacitor/cli/bin/capacitor init FoneBase com.fonebase.admin --web-dir dist",
    "cap:add": "node ./node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:copy": "node ./node_modules/@capacitor/cli/bin/capacitor copy android",
    "cap:build": "cd android && ./gradlew assembleDebug --no-daemon"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "autoprefixer": "^10.5.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "html2canvas": "^1.4.1",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.0.3"
  }
}
